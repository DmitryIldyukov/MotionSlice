# Скопируй в infrastructure/.env и заполни значения:
#   cp infrastructure/.env.example infrastructure/.env

# --- PostgreSQL ---
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=change-me-strong-password
# Порт, проброшенный на хост (внутри сети контейнеры всегда ходят на 5432)
AUTH_DB_PORT=5432

# --- Auth.API ---
ASPNETCORE_ENVIRONMENT=Development
# Порт, на котором API доступен на хосте (внутри контейнера слушает 8080)
AUTH_API_PORT=5104

# JWT-ключ для HS256 (минимум 32 символа). Обязателен.
JWT_SECRET_KEY=your-super-secret-key-at-least-32-chars-long

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
